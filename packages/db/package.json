{
  "name": "@gst/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/harness.ts",
    "./node": "./src/node.ts",
    "./seed": "./src/seed.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.pg.config.ts && tsx scripts/build-migrations.ts",
    "db:migrations": "tsx scripts/build-migrations.ts",
    "db:seed": "tsx scripts/seed.ts",
    "docs:export-schema": "tsx scripts/export-schema-doc.ts",
    "test:coverage": "vitest run --coverage",
    "perf": "tsx perf/search.perf.ts && tsx perf/reports.perf.ts && tsx perf/gstr.perf.ts && tsx perf/gstr2b.perf.ts && tsx perf/backup.perf.ts"
  },
  "devDependencies": {
    "@gst/config": "workspace:*",
    "@gst/gsp": "workspace:*",
    "@gst/print": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@gst/domain": "workspace:*",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3"
  }
}
