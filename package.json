{
  "name": "gst-desk",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "perf": "turbo run perf",
    "format": "prettier --write .",
    "prepare": "husky",
    "ai:eval": "pnpm --filter @gst/ai run ai:eval",
    "test:coverage": "turbo run test:coverage",
    "ci:static": "pnpm lint && pnpm typecheck",
    "ci:audit": "pnpm audit --prod --audit-level high",
    "ci:test": "pnpm test:coverage && pnpm --filter @gst/scripts test",
    "ci:e2e": "turbo run e2e",
    "ci:storybook": "pnpm --filter @gst/ui build-storybook",
    "ci:size": "pnpm --filter web build && pnpm --filter web size",
    "ci:local": "node scripts/ci-local.mjs",
    "release:sync-version": "node scripts/sync-version.mjs",
    "release:version": "changeset version && node scripts/sync-version.mjs",
    "release:tag": "node scripts/release-tag.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.0",
    "vitest": "^5.1.0"
  }
}
