{
  "name": "mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:web": "cross-env VITE_TARGET=capacitor pnpm --filter web exec vite build",
    "build:web:debug": "cross-env VITE_TARGET=capacitor VITE_DEBUG_API=1 pnpm --filter web exec vite build",
    "sync": "cap sync",
    "android": "cap open android",
    "apk:debug": "pnpm run build:web:debug && cross-env GST_DEBUG_API=1 cap sync android && cd android && ./gradlew assembleDebug",
    "bundle:release": "pnpm run build:web && cap sync android && cd android && ./gradlew bundleRelease",
    "ios": "cap sync ios && cap open ios",
    "maestro": "maestro test maestro",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint capacitor.config.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@powersync/capacitor": "^0.10.0",
    "@powersync/web": "^2.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@gst/config": "workspace:*",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "typescript": "~6.0.0",
    "vitest": "^5.1.0"
  }
}
