    "@gst/sync": "workspace:*",
    "@gst/ui": "workspace:*",
    "@mlc-ai/web-llm": "^0.2.87",
    "@powersync/capacitor": "^0.10.0",
    "@powersync/common": "2.5.0",
    "@powersync/drizzle-driver": "^0.8.0",
    "@powersync/web": "^2.6.0",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
