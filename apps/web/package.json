{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "size": "size-limit",
    "perf": "playwright test -c playwright.perf.config.ts",
    "e2e:coverage": "cross-env COVERAGE=1 vite build && cross-env COVERAGE=1 playwright test && nyc report --reporter=text --reporter=json-summary --include \"src/features/**\" --temp-dir .nyc_output --report-dir coverage-e2e"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
