{
  "extends": "@gst/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@gst/domain": ["../../packages/domain/src/index.ts"],
      "@gst/domain/data/*": ["../../packages/domain/data/*"],
      "@gst/db": ["../../packages/db/src/index.ts"],
      "@gst/db/node": ["../../packages/db/src/node.ts"],
      "@gst/db/seed": ["../../packages/db/src/seed.ts"],
      "@gst/ui": ["../../packages/ui/src/index.ts"],
      "@gst/ui/icons": ["../../packages/ui/src/icons.ts"],
      "@gst/ai": ["../../packages/ai/src/index.ts"],
      "@gst/ai/db": ["../../packages/ai/src/db/index.ts"],
      "@gst/ai/fixtures/*": ["../../packages/ai/fixtures/*"],
      "@gst/i18n": ["../../packages/i18n/src/index.ts"],
      "@gst/print": ["../../packages/print/src/index.ts"],
      "@gst/print/fonts.web": ["../../packages/print/src/fonts.web.ts"]
    },
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"]
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"]
}
