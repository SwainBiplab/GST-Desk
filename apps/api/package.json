{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "openapi": "tsx src/openapi-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@gst/db": "workspace:*",
    "@gst/domain": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@hono/otel": "^1.3.0",
    "@hono/zod-openapi": "^1.6.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/sdk-metrics": "^3.1.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "@sentry/node": "^10.0.0",
    "better-auth": "^1.7.18",
    "bullmq": "^6.7.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gst/config": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vitest": "^5.1.0",
    "@gst/sync": "workspace:*"
  }
}
